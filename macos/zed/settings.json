// Zed settings
//
// For information on how to configure Zed, see the Zed
// documentation: https://zed.dev/docs/configuring-zed
//
// To see all of Zed's default settings without changing your
// custom settings, run the `open default settings` command
// from the command palette or from `Zed` application menu.
{
  "project_panel": {
    "dock": "left"
  },
  "outline_panel": {
    "dock": "left"
  },
  "git_panel": {
    "dock": "left"
  },
  "edit_predictions": {
    "provider": "none",
  },
  "session": {
    "trust_all_worktrees": true,
  },
  "theme": "One Light",
  "buffer_font_size": 12,
  "buffer_font_family": "Berkeley Mono",
  "buffer_font_weight": 400,
  "format_on_save": "on",
  "vim_mode": true,
  "inlay_hints": {
    "enabled": false,
  },
  // No need for AI, social or any other collabation crap
  "notification_panel": {
    "button": false,
  },
  "agent": {
    "dock": "right",
    "enabled": false,
    "button": false,
  },
  "collaboration_panel": {
    "dock": "left",
    "button": false,
  },
  "title_bar": {
    "show_sign_in": false,
  },
  "disable_ai": true,
}
